code::
{ WsMap.ar(LFNoise1.kr(0.2).range(0.7, 1), 60, 1200, 0.3, 0, 5, 2, hyst: MouseX.kr(0, 0.15), balance: 1) ! 2 }.play;
::

code::
(
{
	var r = Dstutter(32, Dmap(0.97, 0) * 0.35 + 0.65);
	WsMap.ar(r, 40, 1600, 0.3, 0, 0, 2, 0.4, balance: 1) ! 2
}.play;
)
::

code::
(
{
	var map = Dstutter(Dwhite(100, 800), Dmap(0.9, 3) * 5.99);
	WsMap.ar(Dstutter(16, Dmap(0.8, 4) * 0.4 + 0.6), 40, 2400, 0.3, Dbrown(0, 3, 0.1), map, 2, 0.5, balance: 1, hyst: 0.05) ! 2
}.play;
)
